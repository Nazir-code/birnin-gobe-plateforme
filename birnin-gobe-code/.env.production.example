# BIRNI'NGOBE — gabarit d'environnement de PRODUCTION
#
# À copier en `.env` sur le serveur, puis à compléter. Ce fichier est un modèle
# versionné : il ne doit jamais contenir de valeur réelle.
#
#   cp .env.production.example .env
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#     run --rm -T app php artisan key:generate --show   # coller dans APP_KEY
#
# `.env.example` reste le gabarit de développement ; les deux ne se
# remplacent pas. Chaque variable ci-dessous est réellement lue par
# `config/*.php` — aucune n'est spéculative.
#
# Légende des annotations :
#   [SECRET]  ne doit jamais être versionné ni transmis en clair
#   [GÉNÉRÉ]  produit par une commande, pas choisi à la main
#   [NT]      valeur fournie par Niger Télécom (domaine, DNS, réseau)

# ─── Application ────────────────────────────────────────────────────────────
APP_NAME="BIRNIN GOBE"

# `production` désactive les pages d'erreur détaillées et active les
# optimisations du framework.
APP_ENV=production

# [SECRET] [GÉNÉRÉ] — `php artisan key:generate --show`, puis collée ici.
#
# `--show` et non `--force` : l'image ne contient aucun `.env` — il est exclu
# de la construction et fourni par `env_file` — si bien qu'un `key:generate`
# ordinaire écrirait dans un conteneur jetable, et la clé disparaîtrait avec
# lui. C'est ce fichier-ci, sur l'hôte, qui la conserve.
# Chiffre les sessions et les cookies. La perdre déconnecte tout le monde ;
# la changer après coup rend illisibles les données déjà chiffrées.
APP_KEY=

# Jamais `true` en production : une trace d'exécution exposerait le schéma de
# la base, les chemins du serveur et des valeurs d'environnement.
APP_DEBUG=false

# [NT] — adresse publique réelle, en https, sans barre oblique finale.
# Sert à construire les liens absolus (courriels, redirections).
APP_URL=https://REMPLACER-PAR-LE-DOMAINE

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# ─── Serveur web et TLS (lus par Compose et Caddy) ──────────────────────────
# [NT] — le domaine seul, sans schéma. Le renseigner suffit à déclencher
# l'obtention et le renouvellement automatiques du certificat.
# Laisser `:80` sert en clair, sans certificat : à réserver à une recette
# interne, jamais à un service public.
SITE_ADDRESS=REMPLACER-PAR-LE-DOMAINE

# Adresse prévenue par l'autorité de certification avant expiration.
ACME_EMAIL=

# L'application est toujours derrière Caddy. `*` est correct ici parce que le
# réseau Docker n'est pas routable de l'extérieur : seul Caddy peut atteindre
# PHP-FPM. À restreindre si un répartiteur de charge s'intercale un jour.
TRUSTED_PROXIES=*

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=birnin_gobe
DB_USERNAME=birnin_gobe

# [SECRET] [GÉNÉRÉ] — par exemple `openssl rand -base64 32`.
# Lu à la fois par l'application et par le conteneur PostgreSQL, qui l'utilise
# à la création du volume. Le changer ensuite ne modifie pas le mot de passe
# déjà enregistré dans la base : il faut le changer aussi dans PostgreSQL.
DB_PASSWORD=

# ─── Sessions ───────────────────────────────────────────────────────────────
# En base : les sessions survivent au redéploiement des conteneurs et
# fonctionneraient avec plusieurs instances applicatives (ADR-004).
SESSION_DRIVER=database

# `true` dès que le site est en HTTPS : le cookie de session cesse d'être
# transmis en clair. Avec `SITE_ADDRESS` renseigné, c'est toujours le cas.
SESSION_SECURE_COOKIE=true

SESSION_LIFETIME=120
SESSION_COOKIE=birnin_gobe_session

# À renseigner uniquement si l'application partage ses cookies entre
# sous-domaines. Vide sinon.
SESSION_DOMAIN=

# ─── Cache et files d'attente ───────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# [SECRET] — facultatif. Redis n'écoute que sur le réseau interne de la pile et
# n'est publié sur aucun port de l'hôte. À renseigner si cela change.
REDIS_PASSWORD=

# ─── Journaux ───────────────────────────────────────────────────────────────
# `stderr` plutôt que `single` : les journaux sortent alors sur la sortie
# d'erreur du conteneur, donc dans `docker compose logs`, avec la rotation
# configurée par `docker-compose.prod.yml`. Avec `single`, ils s'écrivent dans
# `storage/logs/laravel.log` — lisible uniquement en entrant dans le conteneur,
# et sans rotation.
LOG_CHANNEL=stderr

# `debug` en production écrit chaque requête SQL et chaque événement du
# framework : volume inutile, et risque de faire figurer des données
# personnelles dans les journaux.
LOG_LEVEL=warning

# ─── Stockage de fichiers ───────────────────────────────────────────────────
# `local` tant que l'étape « Pièces justificatives » n'existe pas : aucun
# appel à `Storage::` dans le code aujourd'hui. Le jour où elle arrivera, cette
# valeur repassera à `s3` avec les identifiants de l'espace objet, et les
# services `minio`/`clamav` seront démarrés avec `--profile fichiers`.
FILESYSTEM_DISK=local
