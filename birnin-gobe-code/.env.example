APP_NAME="BIRNIN GOBE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=birnin_gobe
DB_USERNAME=birnin_gobe
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=birnin
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=birnin-gobe
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Courriels. `log` en developpement : le message part dans storage/logs, en
# clair — on relit le lien de reinitialisation sans serveur SMTP, et aucun
# courriel ne peut atteindre une vraie adresse par accident.
# La production utilise `smtp` : voir .env.production.example.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=ne-pas-repondre@birningobe.local
MAIL_FROM_NAME="BIRNIN GOBE"

# Analyse antivirus des pieces (§15.1). Desactivee par defaut, et c'est sans
# danger : couper l'analyseur n'ouvre rien, ca ferme tout. Chaque piece recoit
# alors le verdict « analyse indisponible », qui interdit le telechargement et
# se voit sur l'ecran d'alertes.
#
# Pour l'activer en local, clamav vit derriere un profil Docker :
#   docker compose --profile fichiers up -d clamav
#   CLAMAV_ENABLED=true
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30
