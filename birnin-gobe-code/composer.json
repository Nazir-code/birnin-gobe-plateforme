{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "birnin-gobe/platform",
  "type": "project",
  "description": "BIRNIN GOBE - plateforme métier de compétition nationale.",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "inertiajs/inertia-laravel": "^3.0",
    "laravel/horizon": "^5.48",
    "filament/filament": "^5.0"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "nunomaduro/collision": "^8.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "test": ["@php artisan test"],
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.4.0",
      "ext-intl": "8.4.0",
      "ext-pdo_pgsql": "8.4.0",
      "ext-pcntl": "8.4.0",
      "ext-bcmath": "8.4.0",
      "ext-redis": "6.1.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
